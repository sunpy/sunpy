[codespell]
skip =
    *.asdf,
    *.fits,
    *.fts,
    *.header,
    *.json,
    *.xsh,
    *cache*,
    *egg*,
    *extern*,
    .git,
    .idea,
    .tox,
    _build,
    *truncated,
    *.svg,
    .asv_env,
    .history,

ignore-words-list =
    ANDed,
    arange,
    iy,
    iy1,
    iy2,
    EIS,
    eis,
    EIT,
    eit,
    HAE,
    hsi,
    Hsi,
    nd,
    NDData,
    NDCube,
    alog,
    alog10,
    FOVs,
    FOV,
    ISES,
    OT,
    ot,
    pn,
    lightyear,
    PNGs,
    setp,
    Precess,
    precess,
    precessed,
    ASO,
    aso,
    blos,
    BLOS,
    gae,
    GAE,
    soop,
    SOOP,
    nin,
    observ,
    te,
    upto,
    afile,
    ans,
